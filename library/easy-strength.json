        {"label": "Hinge", "exercise": "Barbell_Deadlift", "sets": 2, "reps": 5,
         "progression": {"axis": "reps", "increment": 1, "increment_unit": "reps", "advance_when": {"kind": "user_says_easy"}, "on_miss": "hold"}},
        {"label": "Push", "exercise": "Standing_Military_Press", "sets": 2, "reps": 5,
         "progression": {"axis": "reps", "increment": 1, "increment_unit": "reps", "advance_when": {"kind": "user_says_easy"}, "on_miss": "hold"}},
        {"label": "Pull", "exercise": "Chin-Up", "sets": 2, "reps": 5,
         "progression": {"axis": "reps", "increment": 1, "increment_unit": "reps", "advance_when": {"kind": "user_says_easy"}, "on_miss": "hold"}},
        {"label": "Explosive", "exercise": "Power_Clean", "sets": 2, "reps": 5,
