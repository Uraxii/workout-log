          "sets": 5,
          "reps": 5,
          "amrap_last": true,
          "start": {"kind": "retest_pct", "test": "5rm", "pct": 0.9},
          "progression": {
            "axis": "weight",
            "increment": 5,
            "increment_unit": "lb",
            "advance_when": {"kind": "all_prescribed_reps"},
            "on_miss": "hold"
          }
        },
        {
          "label": "Overhead press",
          "exercise": "Standing_Military_Press",
          "sets": 3,
          "rep_range": [8, 12],
          "progression": {
            "axis": "weight",
            "increment": 5,
            "increment_unit": "lb",
            "advance_when": {"kind": "top_of_rep_range"},
            "on_miss": "hold"
          }
        },
        {
